    "AI_CHAT_PANEL": false,
    // 本地 AI 模型（MVP 阶段禁用，质量未达标）
    // 使用位置：src/services/aiService.ts
    "LOCAL_AI_MODEL": false,
    // ========== 报告导出模块 ==========
    // PDF 导出功能（当前仅支持 HTML）
    // 使用位置：src/components/report/
