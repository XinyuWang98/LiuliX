    // 数据库连接（未实现）
    // 使用位置：暂无
    "DATABASE_CONNECT": false,
    // API 数据导入（未实现）
    // 使用位置：暂无
    "API_IMPORT": false,
    // ========== 高级功能模块 ==========
    // 本地 Agent 模式（未实现）
    // 使用位置：暂无
    "AGENT_MODE": false,
    // 高级可视化（未实现）
    // 使用位置：暂无
    "ADVANCED_VIZ": false,
    // 协作功能（未实现）
    // 使用位置：暂无
    "COLLABORATION": false,
    // 下钻节点缓存功能（MVP开发中）
    // 功能说明：将父节点生成的列（如Cluster）缓存到DuckDB，供子节点下钻复用
    // 业务价值：解决下钻失败问题（列不存在错误），提升下钻可靠性
    // 降级策略：禁用时隐藏所有下钻卡片
    // 使用位置：src/components/insights/InsightChainFlow.tsx, src/workers/pyodide/worker.ts, src/services/insights/executor.ts, src/services/insights/inflater.ts
    "ENABLE_DRILL_DOWN_NODE_CACHE": false,
    // ========== 实验性功能模块 ==========
    // Skills 架构（已实现，默认关闭）
    // 使用位置：src/config/skillsConfig.ts
    "SKILLS_ARCHITECTURE": false,
    // Pyodide 离线模式（未实现）
    // 使用位置：暂无
    "PYODIDE_OFFLINE": false,
    // AST 代码增强器（v3.0，默认开启）
    // 使用位置：src/services/prompts/guards/codeEnhancer.ts
    "USE_AST_CODE_ENHANCER": true,
    // 类型上下文传递机制（开发中）
    // 功能说明：在Router/Worker Prompt中传递列类型信息，提升AI生成代码的类型安全性
    // 使用位置：src/services/prompts/cleaningRouter.ts, src/services/prompts/insightRouter.ts
    "ENABLE_TYPE_CONTEXT_PASSING": false,
    // ========== 系统控制模块 ==========
    // 高级 API 配置界面（MVP 阶段隐藏）
    // 使用位置：src/components/settings/APISettings.tsx
    "ENABLE_ADVANCED_API_CONFIG": false,
    // 邀请码前置验证（开发阶段关闭，上线时开启）
    // 使用位置：src/components/data/FileUploader.tsx, src/components/settings/APISettingsSimple.tsx
    "ENABLE_INVITE_CODE_GATE": true,
    // EDA 闭环与 Context 回流（已关闭，等待进一步优化）
    // 使用位置：src/contexts/InsightChainContext.tsx
    "ENABLE_EDA_CONTEXT_LOOP": false,
    // MVP 强制限制上传文件行数 < 100万行
    // 使用位置：src/services/duckdb/ingestion.ts
    "ENABLE_UPLOAD_ROW_LIMIT": true
