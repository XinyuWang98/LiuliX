    // 交互式 HTML 报告（开发中）
    // 使用位置：src/components/report/
    "INTERACTIVE_HTML": false,
    // 自动报告生成
    // 使用位置：src/config/skillsConfig.ts
    "AUTO_REPORT": false,
    // ========== 数据源集成模块 ==========
