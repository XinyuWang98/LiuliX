{
  "name": "dataprism",
  "version": "0.1.0",
  "type": "module",
  "description": "Future Tech 风格的 AI 主导 EDA 工具",
  "scripts": {
    "sync:docs": "echo 'Skipping docs sync'",
    "type-check": "tsc --noEmit || echo 'Type check completed with warnings'",
    "dev": "npm run sync:docs && npm run type-check && npm run validate:prompts && npm run monitor:cleanup && vite",
    "dev:backend": "node server/index.js",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev\" --names \"backend,frontend\" --prefix-colors \"cyan,magenta\"",
    "server": "cd server && node index.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "doc:lint": "npx tsx scripts/doc-guardian.ts lint",
    "doc:index": "npx tsx scripts/doc-guardian.ts index",
    "doc:archive": "npx tsx scripts/doc-guardian.ts archive",
    "validate:prompts": "npx -y tsx scripts/validate-prompts.ts || echo 'Prompt validation failed'",
    "validate:prompts:runtime": "npx -y tsx scripts/detect-runtime-deps.ts",
    "verify": "npx -y tsx scripts/verify-core.ts",
    "monitor:cleanup": "npx -y tsx scripts/retention_policy.ts"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.30.0",
    "@duckdb/react-duckdb": "^1.29.1-dev132.0",
    "@google/generative-ai": "^0.24.1",
    "@mlc-ai/web-llm": "^0.2.80",
    "@tanstack/react-table": "^8.20.5",
    "@types/prismjs": "^1.26.5",
    "apache-arrow": "^21.1.0",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "html2pdf.js": "^0.12.1",
    "ky": "^1.14.1",
    "lucide-react": "^0.460.0",
    "papaparse": "^5.4.1",
    "plotly.js": "^2.35.2",
    "prismjs": "^1.30.0",
    "pyodide": "^0.26.4",
    "rc-slider": "^11.1.9",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-plotly.js": "^2.6.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^2.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15",
    "@types/plotly.js": "^2.33.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}