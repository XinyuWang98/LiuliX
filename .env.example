# 环境变量配置模板
# 复制此文件为 .env.local 并填入真实值

# 功能开关 (Feature Flags)
VITE_FEATURE_MULTI_LEVEL_NAV=true

# DeepSeek API Keys (必填)
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY_CLEANING=your-cleaning-api-key-here
DEEPSEEK_API_KEY_INSIGHT=your-insight-api-key-here

# 邀请码白名单 (逗号分隔，可选)
VALID_INVITE_CODES=CODE1,CODE2,CODE3

# 免费试用限制 (可选)
ENABLE_FREE_TRIAL_LIMIT=true
INVITE_CODE_TOTAL_LIMIT=20
